{
  "business": "T-Mobile",
  "logo": "/tmobile/logo.png",
  "formId": "tmo-postpaid-signup",
  "title": "T-Mobile signup",
  "context": "New-customer phone plan signup on t-mobile.com, up to the credit check. All plans are Unlimited. Each plan's perks, complete (a perk not listed for a plan is not in it): Experience Beyond 2.0, the most premium: 5-Year Price Guarantee, Netflix Standard with ads on us, Hulu with ads on us, Apple TV for $3/month, T-Satellite, 250GB hotspot, 30GB in Canada and Mexico, 15GB in 215+ countries, 4K streaming. Experience More 2.0: Netflix Standard with ads on us, 5-Year Price Guarantee. Essentials 2.0: plain Unlimited at a lower price, no streaming perks. Essentials Saver 2.0: the lowest price, for someone who brings their own phone and needs no extras, no streaming perks. Experience Beyond, Experience More and Essentials Saver each have a Student Savings price for students. Up to 5 lines online, and the price per line drops as lines are added. Each line brings its own phone or buys a new one, and can keep its current number.",
  "theme": {
    "logo": "/tmobile/logo.png",
    "headerTitle": "Fill your signup",
    "buttonLabel": "Fill it in for me",
    "font": "\"TeleNeo\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "fontFaces": [
      { "family": "TeleNeo", "weight": "400", "src": "/fonts-local/TeleNeoWeb-Regular.woff2" },
      { "family": "TeleNeo", "weight": "500 600", "src": "/fonts-local/TeleNeoWeb-Medium.woff2" },
      { "family": "TeleNeo", "weight": "700", "src": "/fonts-local/TeleNeoWeb-Bold.woff2" },
      { "family": "TeleNeo", "weight": "800", "src": "/fonts-local/TeleNeoWeb-ExtraBold.woff2" }
    ],
    "colors": {
      "text": "#141414",
      "muted": "#6A6A6A",
      "primary": "#E20074",
      "primaryHover": "#A7005A",
      "primaryText": "#FFFFFF",
      "border": "#E6E6E6",
      "input": "#6A6A6A",
      "surface": "#F5F5F5"
    },
    "radius": { "button": 4, "input": 2, "card": 12 }
  },
  "fields": [
    { "id": "lines", "label": "Number of lines", "type": "select", "section": "Pick your plan", "category": "basic", "required": true, "suggest": true, "default": "1", "options": ["1", "2", "3", "4", "5"] },
    { "id": "plan", "label": "Plan", "type": "select", "section": "Pick your plan", "category": "basic", "required": true, "suggest": true, "default": "Experience More 2.0", "options": ["Experience Beyond 2.0", "Experience More 2.0", "Essentials 2.0", "Essentials Saver 2.0"] },

    { "id": "line1_name", "label": "Line 1 name", "type": "text", "section": "Name your lines", "category": "basic", "hint": "the user's own first name, for their line" },

    { "id": "device", "label": "Phone for your line", "type": "select", "section": "Shop phones", "category": "basic", "required": true, "suggest": true, "default": "Bring your own phone", "options": ["Bring your own phone", "Buy a new phone"] },
    { "id": "port_number", "label": "Keep your current number?", "type": "select", "section": "Shop phones", "category": "basic", "required": true, "suggest": true, "default": "Yes, keep my number", "options": ["Yes, keep my number", "No, get a new number"] },
    { "id": "current_carrier", "label": "Current carrier", "type": "select", "section": "Shop phones", "category": "basic", "showIf": { "field": "port_number", "value": "Yes, keep my number" }, "options": ["AT&T", "Verizon", "Mint Mobile", "Visible", "Google Fi", "US Mobile", "Cricket Wireless", "Metro by T-Mobile", "Boost Mobile", "Xfinity Mobile", "Spectrum Mobile", "Other"] },

    { "id": "first_name", "label": "First name", "type": "text", "section": "Personal info", "category": "basic", "required": true },
    { "id": "last_name", "label": "Last name", "type": "text", "section": "Personal info", "category": "basic", "required": true },
    { "id": "dob", "label": "Date of birth", "type": "date", "section": "Personal info", "category": "personal", "required": true, "identity": true },
    { "id": "ssn4", "label": "Last 4 digits of SSN", "type": "text", "section": "Personal info", "category": "sensitive", "required": true, "never": true },
    { "id": "phone", "label": "Phone number", "type": "tel", "section": "Personal info", "category": "personal", "required": true },
    { "id": "email", "label": "Email", "type": "email", "section": "Personal info", "category": "basic", "required": true },
    { "id": "account_pin", "label": "Account PIN", "type": "text", "section": "Personal info", "category": "sensitive", "required": true, "never": true },

    { "id": "street", "label": "Address", "type": "text", "section": "Residential address", "category": "basic", "required": true },
    { "id": "apt", "label": "Apt./ Suite", "type": "text", "section": "Residential address", "category": "basic" },
    { "id": "city", "label": "City", "type": "text", "section": "Residential address", "category": "basic", "required": true },
    { "id": "state", "label": "State", "type": "select", "section": "Residential address", "category": "basic", "required": true, "options": ["AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "DC", "FL", "GA", "HI", "ID", "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA", "MI", "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ", "NM", "NY", "NC", "ND", "OH", "OK", "OR", "PA", "PR", "RI", "SC", "SD", "TN", "TX", "UT", "VT", "VA", "VI", "WA", "WV", "WI", "WY"] },
    { "id": "zip", "label": "ZIP code", "type": "text", "section": "Residential address", "category": "basic", "required": true },
    { "id": "delivery_same", "label": "Use as delivery address", "type": "select", "section": "Residential address", "category": "basic", "suggest": true, "default": "Yes", "options": ["Yes", "No"] },

    { "id": "esign_consent", "label": "E-SIGN consent", "type": "select", "section": "Consents", "category": "basic", "required": true, "never": true, "options": ["Yes"] },
    { "id": "credit_consent", "label": "Credit check consent", "type": "select", "section": "Consents", "category": "basic", "required": true, "never": true, "options": ["Yes"] }
  ]
}
