{
  "business": "SpaceXAI",
  "logo": "/spacexai/logo-black.png",
  "formId": "spacexai-swe-ai-infra",
  "title": "Software Engineer application",
  "context": "Build the pipelines that move telemetry from thousands of Starlink satellites and every Starship flight into the clusters that train our Grok models. You'll own systems end to end, from the data on the vehicle to the model in production.",
  "fields": [
    { "id": "first_name", "label": "First Name", "type": "text", "section": "About you", "category": "basic", "required": true },
    { "id": "last_name", "label": "Last Name", "type": "text", "section": "About you", "category": "basic", "required": true },
    { "id": "over_18", "label": "Are you 18 or older?", "type": "select", "section": "About you", "category": "personal", "required": true, "options": ["Yes", "No"] },
    { "id": "email", "label": "Email", "type": "email", "section": "About you", "category": "basic", "required": true },
    { "id": "phone", "label": "Phone", "type": "tel", "section": "About you", "category": "personal", "required": true },
    { "id": "location", "label": "Location", "type": "text", "section": "About you", "category": "basic", "required": true, "placeholder": "Seattle, WA" },
    { "id": "us_person", "label": "U.S. person status (ITAR)", "type": "select", "section": "About you", "category": "personal", "required": true, "options": ["U.S. citizen", "Lawful permanent resident", "Protected individual", "Not a U.S. person"] },

    { "id": "degree", "label": "Degree", "type": "select", "section": "Education", "category": "basic", "required": true, "options": ["High school", "Associate's", "Bachelor's (in progress)", "Bachelor's", "Master's", "PhD"] },
    { "id": "school", "label": "School", "type": "text", "section": "Education", "category": "basic", "required": true },
    { "id": "major", "label": "Discipline", "type": "text", "section": "Education", "category": "basic", "required": true },
    { "id": "grad_year", "label": "Graduation Year", "type": "number", "section": "Education", "category": "basic", "required": true, "placeholder": "Expected, if still in school" },
    { "id": "gpa", "label": "GPA", "type": "text", "section": "Education", "category": "personal" },

    { "id": "employer", "label": "Current or Most Recent Employer", "type": "text", "section": "Experience", "category": "basic", "required": true },
    { "id": "job_title", "label": "Title", "type": "text", "section": "Experience", "category": "basic", "required": true },
    { "id": "years_experience", "label": "Years of Work Experience", "type": "number", "section": "Experience", "category": "basic", "required": true },
    { "id": "skills", "label": "Top Technical Skills", "type": "text", "section": "Experience", "category": "basic", "required": true, "placeholder": "e.g. C++, Rust, Python" },

    { "id": "exceptional_work", "label": "What exceptional work have you done?", "type": "textarea", "section": "Questions", "category": "personal", "required": true, "maxWords": 50 },
    { "id": "why_spacexai", "label": "Why SpaceXAI? What would you want to build here?", "type": "textarea", "section": "Questions", "category": "personal", "required": true, "maxWords": 50 }
  ]
}
