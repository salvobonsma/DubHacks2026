GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FILL_MODEL=gemini-3.5-flash
# Forms with plan/lines/device choices get reasoned suggestions; Flash by default (about 4-7 s), Flash-Lite is faster but flip-flops
# GEMINI_SUGGEST_MODEL=gemini-3.5-flash
# DATA_DIR=/data

# Real Google sign-in. Unset = no Google option at all (sample personas exist only on /demo, for testing).
# Step by step: plan/LIVE-SETUP.md. Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application).
# Enable the People, Gmail, Drive and Google Picker APIs.
# Authorized JS origin: http://localhost:3000 (plus https://<your domain>)
# Authorized redirect URI: http://localhost:3000/api/connectors/google/callback (plus https://<your domain>/api/connectors/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# full (default): profile, address, phone, birthday, contacts, targeted Gmail searches and Drive search. Works for the
#   test users listed on the consent screen while the app is in Testing mode; Google shows an unverified-app screen.
# picker: sign-in + only the Drive files the user picks in the Google Picker (drive.file), Gmail off; address, phone
#   and birthday are an opt-in extra. Safe for any account. Needs GOOGLE_API_KEY and GOOGLE_APP_ID.
# GOOGLE_ACCESS=full
# Picker only: a browser API key restricted to your origins, and the Cloud project NUMBER (not its id).
# GOOGLE_API_KEY=
# GOOGLE_APP_ID=

# Real Microsoft import (profile, OneDrive, Outlook). Unset = the Microsoft tile is hidden.
# Azure portal > App registrations > New (accounts in any org directory + personal Microsoft accounts), Web platform; delegated User.Read, Files.Read, Mail.Read, offline_access.
# Redirect URI: http://localhost:3000/api/connectors/microsoft/callback (plus https://<your domain>/api/connectors/microsoft/callback when deployed)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional public origin, no trailing slash (e.g. https://formly.example.com). Used for OAuth redirect URIs and the
# phone-scan / race QR links. Requests that arrive on localhost keep http://localhost:3000 for OAuth, so laptop testing
# works with it set. Leave unset locally and QR codes use this machine's Wi-Fi IP.
# PUBLIC_ORIGIN=

# Merchant sites on OTHER origins allowed to open the Formly popup (comma separated, e.g. https://shop.example).
# The demo merchants live on this origin and need nothing here. Any other returnUrl is refused, so approved
# answers can only go back to this site or a merchant listed here.
# FORMLY_MERCHANT_ORIGINS=

# Every visitor's data (sources, twin, sessions, tokens…) is deleted this many minutes after their first upload. Default 60.
# FORMLY_TTL_MINUTES=60

# Bank via Plaid (Trial plan, plan/LIVE-SETUP.md). Unset = no "Connect your bank" option at all.
# Plaid dashboard > Developers > Keys. Allowed redirect URIs: https://<your domain>/formly/plaid-oauth (and, in sandbox only, http://localhost:3000/formly/plaid-oauth).
PLAID_CLIENT_ID=
# The secret for the environment below (sandbox and production secrets differ).
PLAID_SECRET=
# sandbox (default, test banks: user_good / pass_good) or production (real banks).
# PLAID_ENV=sandbox
